{
  "name": "bis-intelliguide-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:seed": "tsx scripts/seed/seed.ts",
    "eval:rag": "tsx scripts/evaluation/evaluate_rag.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4",
    "tsx": "^4.19.1"
  },
  "packageManager": "pnpm@11.25.0"
}
