{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_*",
    "DIRECT_*",
    "POSTGRES_*",
    "NODE_ENV",
    "PORT",
    "API_URL",
    "API_PREFIX",
    "CORS_ORIGIN",
    "JWT_*",
    "LLM_*",
    "OPENROUTER_*",
    "GEMINI_*",
    "GOOGLE_*",
    "OPENAI_*",
    "ANTHROPIC_*",
    "MISTRAL_*",
    "EMBEDDING_*",
    "RERANKER_*",
    "TRANSLATION_*",
    "HF_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
