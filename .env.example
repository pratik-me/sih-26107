# Database & Vector Store
DATABASE_URL="postgresql://postgres:469182@localhost:5432/bis_saarthi?schema=public"

# Backend Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=bis_saarthi_jwt_secret_key_super_secure_2026_x99a
JWT_REFRESH_SECRET=bis_saarthi_jwt_refresh_secret_key_2026_super_safe
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Provider Configuration
LLM_PROVIDER=openai # options: anthropic, openai, deterministic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Embedding Provider
EMBEDDING_PROVIDER=openai # options: openai, local-multilingual
EMBEDDING_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Reranker Provider
RERANKER_PROVIDER=cross-encoder # options: cross-encoder, bge-reranker, local-bm25
RERANKER_API_KEY=

# Translation / Multilingual (IndicTrans2 / NLLB / Cloud)
TRANSLATION_PROVIDER=indic-pipeline # options: indic-pipeline, cloud, passthrough

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="BIS Saarthi"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true
