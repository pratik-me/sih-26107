# Database & Vector Store
DATABASE_URL="postgresql://username:password@localhost:5432/database?schema=public"

# Backend Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Authentication & Security
JWT_SECRET=bis_saarthi_jwt_secret_key_secure_2026_x99a
JWT_REFRESH_SECRET=bis_saarthi_jwt_refresh_secret_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# AI Model Provider Configuration
LLM_PROVIDER=mistral # options: mistral, gemini, openai, anthropic, openrouter, deterministic
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest # options: mistral-large-latest, mistral-small-latest, open-mixtral-8x7b, codestral-latest
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME="BIS Saarthi"
OPENROUTER_TRANSLATION_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini


# Embedding Provider
EMBEDDING_PROVIDER=openrouter # options: openrouter, openai, local-multilingual
OPENROUTER_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
EMBEDDING_API_KEY=your_openai_api_key
EMBEDDING_MODEL=text-embedding-3-small

# Reranker Provider
RERANKER_PROVIDER=cross-encoder # options: cross-encoder, bge-reranker, local-bm25
RERANKER_API_KEY=

# Translation / Multilingual (Hugging Face / IndicTrans2 / NLLB)
TRANSLATION_PROVIDER=indic-pipeline # options: indic-pipeline, cloud, passthrough
HF_TOKEN=hf_your_token_here
HF_TRANSLATION_MODEL=facebook/nllb-200-distilled-600M # options: facebook/nllb-200-distilled-600M, ai4bharat/indictrans2-indic-en-1B

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME="BIS Saarthi"
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

